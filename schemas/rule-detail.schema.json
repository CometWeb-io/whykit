{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/rule-detail.schema.json",
  "title": "WhyKit lint rule",
  "description": "Output of `whykit rules <code> --json`.",
  "type": "object",
  "required": [
    "contract_version",
    "code",
    "default_level",
    "summary",
    "why",
    "fix"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
    },
    "default_level": {
      "enum": [
        "error",
        "warning"
      ]
    },
    "summary": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "fix": {
      "type": "string"
    },
    "security": {
      "type": "boolean",
      "description": "Lowering or disabling this rule in whykit.toml requires a reason."
    },
    "custom": {
      "type": "boolean",
      "description": "Defined by the vault's whykit.toml ([[rules.custom]])."
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "checks": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
