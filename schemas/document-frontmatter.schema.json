{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/document-frontmatter.schema.json",
  "title": "WhyKit document front matter",
  "type": "object",
  "required": [
    "title",
    "type",
    "status",
    "owner",
    "created",
    "last_updated",
    "source_of_truth",
    "sensitivity"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "type": {
      "enum": [
        "outcome",
        "claim",
        "strategy",
        "research",
        "framework",
        "specification",
        "decision",
        "map-of-content",
        "guide",
        "reference"
      ]
    },
    "status": {
      "enum": [
        "template",
        "draft",
        "in_review",
        "approved",
        "superseded",
        "archived"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "pattern": "^(YYYY-MM-DD|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^(YYYY-MM-DD|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "source_of_truth": {
      "type": "boolean"
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^E-[0-9]{3,}$"
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_by": {
      "type": "string",
      "pattern": "^(YYYY-MM-DD|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^(D-XXX|D-[0-9]{3,})$"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^D-[0-9]{3,}$"
    },
    "delivery_status": {
      "enum": [
        "draft",
        "ready_to_send",
        "sent"
      ]
    },
    "sent_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "provenance": {
      "$ref": "https://cometweb.io/schemas/whykit/provenance.schema.json"
    },
    "superseded_by": {
      "type": "string",
      "pattern": "^D-[0-9]{3,}$"
    },
    "applies_to": {
      "description": "Decisions only: repository-relative globs for the code this decision covers, matched by `whykit affected`. Anchored at the code repository root; `**` spans directories. May change on an approved decision without supersession. A single string is read as a one-item list.",
      "type": [
        "string",
        "array"
      ],
      "minLength": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 64
    },
    "watch_terms": {
      "description": "Decisions only: whole words (case-insensitive) whose appearance in added or removed lines of a diff makes `whykit affected` report the decision, e.g. a library the decision chose against. May change on an approved decision without supersession.",
      "type": [
        "string",
        "array"
      ],
      "minLength": 2,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100
      },
      "maxItems": 32
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_of_truth": {
            "const": true
          }
        },
        "required": [
          "source_of_truth"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery_status": {
            "const": "sent"
          }
        },
        "required": [
          "delivery_status"
        ]
      },
      "then": {
        "required": [
          "sent_at"
        ]
      }
    }
  ],
  "additionalProperties": true
}
