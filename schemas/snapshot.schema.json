{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/snapshot.schema.json",
  "title": "WhyKit deterministic vault snapshot",
  "type": "object",
  "required": ["format", "contract_version", "snapshot_id", "as_of", "files", "summary"],
  "properties": {
    "format": {"const": "whykit.snapshot/v1"},
    "contract_version": {"const": 1},
    "snapshot_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "summary": {"type": "object"}
  },
  "additionalProperties": false
}
