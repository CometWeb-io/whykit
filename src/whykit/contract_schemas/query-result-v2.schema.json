{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/query-result-v2.schema.json",
  "title": "WhyKit query result (claims opt-in v2)",
  "type": "object",
  "required": [
    "contract_version",
    "query",
    "total",
    "returned",
    "results"
  ],
  "properties": {
    "contract_version": {
      "const": 2
    },
    "query": {
      "description": "The filters this result was computed with; null means the filter was not applied.",
      "type": "object",
      "required": [
        "text",
        "limit"
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_only": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "title",
          "type",
          "status",
          "source_ids"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "sensitivity": {
            "type": "string"
          },
          "source_of_truth": {
            "type": "boolean"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E-[0-9]{3,}$"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "score": {
            "type": "number"
          },
          "claim_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^C-[0-9]{3,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "claim": {
            "$ref": "https://cometweb.io/schemas/whykit/claim-assessment.schema.json"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^C-[0-9]{3,}$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "returned": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
