{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/evidence-artifact.schema.json",
  "title": "WhyKit immutable offline evidence artifact",
  "description": "Canonical UTF-8 JSON file under 00-context/artifacts/E-NNN/<raw digest>.json. Runtime additionally checks real UTC time, canonical base64, decoded byte size and SHA-256. This envelope is not a CLI result and must never be copied into context packs or exports.",
  "type": "object",
  "required": ["format", "evidence_id", "source_version", "recorded_at", "sensitivity", "size_bytes", "content_base64"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "whykit.evidence-artifact/v1"},
    "evidence_id": {"type": "string", "pattern": "^E-[0-9]{3,}(?![\\s\\S])"},
    "source_version": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"},
    "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z(?![\\s\\S])"},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "size_bytes": {"type": "integer", "minimum": 0, "maximum": 8388608},
    "content_base64": {"type": "string", "maxLength": 11184812}
  }
}
