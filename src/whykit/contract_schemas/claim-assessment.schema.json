{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/claim-assessment.schema.json",
  "title": "WhyKit current captured claim assessment",
  "type": "object",
  "required": [
    "claim_id",
    "path",
    "status",
    "verification_status",
    "as_of",
    "last_verified",
    "binding_valid",
    "history_reconstructed",
    "reasons",
    "relations"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^C-[0-9]{3,}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "superseded",
        "archived"
      ]
    },
    "verification_status": {
      "enum": [
        "supported",
        "disputed",
        "unsupported",
        "unknown"
      ]
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "last_verified": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "binding_valid": {
      "type": "boolean"
    },
    "history_reconstructed": {
      "const": false
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "source_snapshot_hash",
          "fragment",
          "relation",
          "snapshot",
          "observed_at",
          "rationale",
          "usable",
          "reasons"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^E-[0-9]{3,}$"
          },
          "source_snapshot_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "fragment": {
            "type": "string",
            "pattern": "^lines:[1-9][0-9]*-[1-9][0-9]*$"
          },
          "relation": {
            "enum": [
              "supports",
              "contradicts"
            ]
          },
          "snapshot": {
            "type": "string",
            "pattern": "^00-context/claim-snapshots/[0-9a-f]{64}\\.txt$"
          },
          "observed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "fragment_text": {
            "type": "string"
          },
          "usable": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
