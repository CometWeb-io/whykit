{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/decision-record.schema.json",
  "title": "WhyKit decision record metadata",
  "type": "object",
  "required": [
    "decision_id",
    "title",
    "status",
    "owner",
    "created",
    "last_updated",
    "sensitivity"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^D-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "superseded",
        "archived"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^E-[0-9]{3,}$"
      }
    },
    "review_by": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^D-[0-9]{3,}$"
    },
    "provenance": {
      "$ref": "https://cometweb.io/schemas/whykit/provenance.schema.json"
    },
    "superseded_by": {
      "type": "string",
      "pattern": "^D-[0-9]{3,}$"
    }
  },
  "if": {
    "properties": {"status": {"const": "approved"}}
  },
  "then": {
    "required": ["review_by"],
    "properties": {
      "provenance": {
        "properties": {"human_reviewed": {"const": true}}
      }
    }
  },
  "additionalProperties": true
}
