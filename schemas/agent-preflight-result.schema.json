{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/agent-preflight-result.schema.json",
  "title": "WhyKit governed proposal preflight result",
  "type": "object",
  "required": [
    "format",
    "proposal_id",
    "proposal_sha256",
    "as_of",
    "review_scope",
    "verdict",
    "review_required",
    "semantics_checked",
    "execution_authorized",
    "referenced_decisions",
    "findings"
  ],
  "properties": {
    "format": {
      "const": "whykit.agent-preflight/v1"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "review_scope": {
      "const": "explicit_decision_ids_only"
    },
    "verdict": {
      "enum": [
        "blocked",
        "review_required"
      ]
    },
    "review_required": {
      "const": true
    },
    "semantics_checked": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "referenced_decisions": {
      "type": "integer",
      "minimum": 1
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "decision_id",
          "problems"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "pattern": "^D-[0-9]{3,}$"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
