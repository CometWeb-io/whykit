{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/agent-preflight-proposal.schema.json",
  "title": "WhyKit explicit agent proposal manifest",
  "type": "object",
  "required": [
    "proposal_id",
    "decision_ids"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "decision_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^D-[0-9]{3,}$"
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
