{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/history-report.schema.json",
  "title": "WhyKit immutable-history report",
  "description": "Output of `whykit history --json`. Blocked rewrites are a report with `passed: false` (exit 1). With `--staged`, `head` is `INDEX` and `staged` is true.",
  "type": "object",
  "required": [
    "contract_version",
    "base",
    "head",
    "passed",
    "blocked"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "base": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "staged": {
      "type": "boolean",
      "description": "True for `whykit history --staged`: head is the Git index (reported as INDEX), not a commit."
    },
    "passed": {
      "type": "boolean"
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status",
          "path"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "enum": ["review_without_event", "approval_without_event"],
            "description": "Present when the blocked change lacks a fresh matching review or approval receipt."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
