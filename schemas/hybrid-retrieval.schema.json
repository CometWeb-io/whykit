{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/hybrid-retrieval.schema.json",
  "title": "WhyKit bounded hybrid retrieval",
  "type": "object",
  "properties": {
    "format": {
      "const": "whykit.hybrid-retrieval/v1"
    },
    "contract_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "ranked",
        "refused"
      ]
    },
    "reason": {
      "enum": [
        null,
        "scope_too_large"
      ]
    },
    "valid_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "query": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 4096
        },
        "doc_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "sensitivity": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_only": {
          "type": "boolean"
        },
        "allowed_sensitivities": {
          "type": "array",
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "uniqueItems": true
        },
        "validity": {
          "enum": [
            "active_or_unknown",
            "active"
          ]
        },
        "decision_role": {
          "enum": [
            "premise",
            "reference"
          ]
        }
      },
      "required": [
        "text",
        "doc_type",
        "status",
        "owner",
        "sensitivity",
        "source_id",
        "tag",
        "canonical_only",
        "allowed_sensitivities",
        "validity",
        "decision_role"
      ],
      "additionalProperties": false
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "sensitivity": {
            "type": "string"
          },
          "source_of_truth": {
            "type": "boolean"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E-[0-9]{3,}$"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "decision_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "lexical_score": {
            "type": "number",
            "minimum": 0
          },
          "lexical_normalized": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "graph_support": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "explanation": {
            "anyOf": [
              {
                "$ref": "#/$defs/explanation"
              },
              {
                "type": "null"
              }
            ]
          },
          "validity": {
            "$ref": "#/$defs/validity"
          },
          "applicability": {
            "$ref": "#/$defs/applicability"
          }
        },
        "required": [
          "path",
          "title",
          "type",
          "status",
          "owner",
          "sensitivity",
          "source_of_truth",
          "source_ids",
          "tags",
          "score",
          "decision_id",
          "review_by",
          "lexical_score",
          "lexical_normalized",
          "graph_support",
          "explanation",
          "validity",
          "applicability"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "document",
              "evidence"
            ]
          },
          "target": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "kind",
          "target",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "stats": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "documents": {
              "type": "integer",
              "minimum": 0
            },
            "evidence_nodes": {
              "type": "integer",
              "minimum": 0
            },
            "corpus_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "constructed_nodes": {
              "type": "integer",
              "minimum": 0
            },
            "constructed_edges": {
              "type": "integer",
              "minimum": 0
            },
            "seeds": {
              "type": "integer",
              "minimum": 0
            },
            "visited_nodes": {
              "type": "integer",
              "minimum": 0
            },
            "examined_edges": {
              "type": "integer",
              "minimum": 0
            },
            "matched_candidates": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "documents",
            "evidence_nodes",
            "corpus_tokens",
            "constructed_nodes",
            "constructed_edges",
            "seeds",
            "visited_nodes",
            "examined_edges",
            "matched_candidates"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "truncation": {
      "$ref": "#/$defs/truncation"
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false
    },
    "semantics_checked": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "format",
    "contract_version",
    "status",
    "reason",
    "valid_on",
    "query",
    "limits",
    "results",
    "citations",
    "stats",
    "truncation",
    "execution_authorized",
    "semantics_checked"
  ],
  "additionalProperties": false,
  "$defs": {
    "explanation": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "seed_normalized": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "edge_weight_product": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "evidence",
                  "wikilink",
                  "outcome_decision",
                  "measurement_claim"
                ]
              },
              "walk_direction": {
                "enum": [
                  "forward",
                  "reverse"
                ]
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "from",
              "to",
              "type",
              "walk_direction",
              "weight"
            ],
            "additionalProperties": false
          },
          "maxItems": 2
        }
      },
      "required": [
        "seed",
        "depth",
        "seed_normalized",
        "edge_weight_product",
        "decay",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "seed_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_edges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "construction_nodes": {
          "const": 25000
        },
        "visible_bytes": {
          "const": 67108864
        },
        "tokens": {
          "const": 2000000
        },
        "constructed_edges": {
          "const": 200000
        },
        "query_bytes": {
          "const": 4096
        }
      },
      "required": [
        "limit",
        "seed_limit",
        "max_depth",
        "max_nodes",
        "max_edges",
        "construction_nodes",
        "visible_bytes",
        "tokens",
        "constructed_edges",
        "query_bytes"
      ],
      "additionalProperties": false
    },
    "truncation": {
      "type": "object",
      "properties": {
        "seeds": {
          "type": "boolean"
        },
        "max_depth": {
          "type": "boolean"
        },
        "max_nodes": {
          "type": "boolean"
        },
        "max_edges": {
          "type": "boolean"
        },
        "results": {
          "type": "boolean"
        }
      },
      "required": [
        "seeds",
        "max_depth",
        "max_nodes",
        "max_edges",
        "results"
      ],
      "additionalProperties": false
    },
    "validity": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "active",
            "not_yet",
            "expired",
            "unknown",
            "invalid"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "valid_from",
        "valid_until"
      ],
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "properties": {
        "as_of": {
          "type": "string"
        },
        "state": {
          "enum": [
            "applicable",
            "needs_review",
            "reference",
            "unknown",
            "not_decision"
          ]
        },
        "premise": {
          "type": "boolean"
        },
        "local_approval": {
          "enum": [
            "matched",
            "unverified",
            "unavailable",
            "not_applicable"
          ]
        },
        "declared_validity": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "active",
                "not_yet",
                "expired",
                "unknown",
                "invalid"
              ]
            },
            "valid_from": {
              "type": [
                "string",
                "null"
              ]
            },
            "valid_until": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "state",
            "valid_from",
            "valid_until"
          ],
          "additionalProperties": false
        },
        "reasons": {
          "type": "array",
          "items": {
            "enum": [
              "not_decision",
              "invalid_decision",
              "ambiguous_decision",
              "not_approved",
              "superseded",
              "approval_unavailable",
              "approval_unverified",
              "record_future",
              "validity_unknown",
              "validity_not_yet",
              "validity_expired",
              "validity_invalid",
              "review_overdue",
              "review_date_invalid",
              "review_required",
              "evidence_missing",
              "evidence_retired",
              "evidence_stale",
              "evidence_date_invalid",
              "evidence_future",
              "evidence_unbounded",
              "no_evidence",
              "claim_unavailable",
              "claim_unpinned",
              "claim_snapshot_changed",
              "claim_contradicted",
              "claim_model_assessment",
              "claim_source_changed",
              "claim_source_unknown",
              "claim_source_ambiguous",
              "claim_source_future",
              "claim_validity_unknown",
              "claim_not_current",
              "review_archived"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "as_of",
        "state",
        "premise",
        "local_approval",
        "declared_validity",
        "reasons"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "state": {
            "const": "applicable"
          }
        }
      },
      "then": {
        "properties": {
          "premise": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "premise": {
            "const": false
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "refused"
      }
    }
  },
  "then": {
    "properties": {
      "reason": {
        "const": "scope_too_large"
      },
      "results": {
        "maxItems": 0
      },
      "citations": {
        "maxItems": 0
      },
      "stats": {
        "type": "null"
      }
    }
  },
  "else": {
    "properties": {
      "reason": {
        "type": "null"
      },
      "stats": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_nodes": {
            "type": "integer",
            "minimum": 0
          },
          "corpus_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "constructed_nodes": {
            "type": "integer",
            "minimum": 0
          },
          "constructed_edges": {
            "type": "integer",
            "minimum": 0
          },
          "seeds": {
            "type": "integer",
            "minimum": 0
          },
          "visited_nodes": {
            "type": "integer",
            "minimum": 0
          },
          "examined_edges": {
            "type": "integer",
            "minimum": 0
          },
          "matched_candidates": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "documents",
          "evidence_nodes",
          "corpus_tokens",
          "constructed_nodes",
          "constructed_edges",
          "seeds",
          "visited_nodes",
          "examined_edges",
          "matched_candidates"
        ],
        "additionalProperties": false
      }
    }
  }
}
