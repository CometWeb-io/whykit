{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/claim-record.schema.json",
  "title": "WhyKit claim metadata",
  "type": "object",
  "required": [
    "type",
    "claim_id",
    "title",
    "statement",
    "scope",
    "status",
    "owner",
    "created",
    "last_updated",
    "valid_from",
    "sensitivity"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "claim"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^C-[0-9]{3,}$"
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "superseded",
        "archived"
      ]
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "verification_status": false,
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "valid_from": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "valid_to": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "last_verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "review_by": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^C-[0-9]{3,}$"
    },
    "superseded_by": {
      "type": "string",
      "pattern": "^C-[0-9]{3,}$"
    },
    "provenance": {
      "$ref": "https://cometweb.io/schemas/whykit/provenance.schema.json"
    },
    "source_of_truth": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "if": {
    "properties": {
      "status": {
        "const": "approved"
      }
    }
  },
  "then": {
    "required": [
      "last_verified",
      "review_by"
    ]
  }
}
