{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/diff-report.schema.json",
  "title": "WhyKit decision diff",
  "description": "Output of `whykit diff --json`: what changed in decisions, evidence and lint findings between the merge base of --base and --head and --head, read from Git objects. Always exit 0 when the comparison ran.",
  "type": "object",
  "required": [
    "contract_version",
    "root",
    "prefix",
    "base",
    "head",
    "merge_base",
    "head_commit",
    "today",
    "vault_at_base",
    "vault_at_head",
    "changed",
    "decisions",
    "evidence",
    "affected_decisions",
    "lint"
  ],
  "$defs": {
    "decision": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^D-\\d{3,}$"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "path",
        "line",
        "level",
        "code",
        "message"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "level": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "counts": {
      "type": "object",
      "required": [
        "errors",
        "warnings"
      ],
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "fieldChanges": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "properties": {
    "contract_version": {
      "const": 1
    },
    "root": {
      "type": "string"
    },
    "prefix": {
      "type": "string",
      "description": "The vault's path inside the Git work tree, with a trailing slash; empty at the top level."
    },
    "base": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "merge_base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$",
      "description": "The commit the head is compared with: the merge base of base and head."
    },
    "head_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "today": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "vault_at_base": {
      "type": "boolean"
    },
    "vault_at_head": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean",
      "description": "True when any list in decisions, evidence or lint.introduced/fixed is non-empty."
    },
    "decisions": {
      "type": "object",
      "required": [
        "added",
        "removed",
        "superseded",
        "archived",
        "status_changed",
        "review_moved",
        "moved"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/decision"
              },
              {
                "type": "object",
                "required": [
                  "supersedes",
                  "chain"
                ],
                "properties": {
                  "supersedes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^D-\\d{3,}$"
                    }
                  },
                  "chain": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^D-\\d{3,}$"
                    }
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "superseded": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/decision"
              },
              {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "superseded_by",
                  "chain"
                ],
                "properties": {
                  "from": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "to": {
                    "const": "superseded"
                  },
                  "superseded_by": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^D-\\d{3,}$"
                    }
                  },
                  "chain": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^D-\\d{3,}$"
                    }
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "archived": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/decision"
              },
              {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "superseded_by",
                  "chain"
                ],
                "properties": {
                  "from": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "to": {
                    "const": "archived"
                  },
                  "superseded_by": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^D-\\d{3,}$"
                    }
                  },
                  "chain": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^D-\\d{3,}$"
                    }
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "status_changed": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/decision"
              },
              {
                "type": "object",
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "to": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "review_moved": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/decision"
              },
              {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "direction"
                ],
                "properties": {
                  "from": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "to": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "direction": {
                    "enum": [
                      "later",
                      "earlier",
                      "set",
                      "cleared",
                      "changed"
                    ]
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "added",
        "retired",
        "resourced",
        "updated",
        "removed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "type",
              "date",
              "accessed",
              "location",
              "claims"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E-\\d{3,}$"
              },
              "source": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "accessed": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "claims": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "retired": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "retired_on",
              "why",
              "replaced_by"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E-\\d{3,}$"
              },
              "source": {
                "type": "string"
              },
              "retired_on": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "replaced_by": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "resourced": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "changes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E-\\d{3,}$"
              },
              "changes": {
                "$ref": "#/$defs/fieldChanges"
              }
            },
            "additionalProperties": true
          }
        },
        "updated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "changes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E-\\d{3,}$"
              },
              "changes": {
                "$ref": "#/$defs/fieldChanges"
              }
            },
            "additionalProperties": true
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E-\\d{3,}$"
              },
              "source": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "affected_decisions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/decision"
          },
          {
            "type": "object",
            "required": [
              "evidence"
            ],
            "properties": {
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "change"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^E-\\d{3,}$"
                    },
                    "change": {
                      "enum": [
                        "retired",
                        "resourced",
                        "updated",
                        "removed"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "lint": {
      "type": "object",
      "required": [
        "base",
        "head",
        "introduced",
        "fixed"
      ],
      "properties": {
        "base": {
          "$ref": "#/$defs/counts"
        },
        "head": {
          "$ref": "#/$defs/counts"
        },
        "introduced": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "fixed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
