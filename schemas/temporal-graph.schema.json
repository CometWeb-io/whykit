{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/temporal-graph.schema.json",
  "title": "WhyKit recorded snapshot and asserted valid time",
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "path",
        "title",
        "type",
        "status",
        "owner",
        "sensitivity",
        "decision_id",
        "source_of_truth",
        "validity"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "document",
            "evidence"
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "sensitivity": {
          "type": "string"
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_id": {
          "type": "string"
        },
        "source_of_truth": {
          "type": "boolean"
        },
        "validity": {
          "type": "object",
          "required": [
            "state",
            "valid_from",
            "valid_until"
          ],
          "properties": {
            "state": {
              "enum": [
                "active",
                "unknown",
                "not_yet",
                "expired",
                "invalid"
              ]
            },
            "valid_from": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "valid_until": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "type"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "enum": [
            "wikilink",
            "evidence",
            "supersedes",
            "outcome_decision",
            "measurement_claim"
          ]
        }
      },
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "required": [
        "node",
        "reason"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "invalid_metadata",
            "unavailable_dependency",
            "unavailable_evidence",
            "unavailable_decision",
            "retired_evidence",
            "dependency_cycle",
            "validity_invalid",
            "validity_unknown",
            "overlapping_supersession"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "contract_version",
    "recorded_revision",
    "recorded_at",
    "recorded_time_source",
    "valid_on",
    "target",
    "exists",
    "ambiguous",
    "nodes",
    "edges",
    "review_signals",
    "max_nodes",
    "truncated",
    "omitted_tree_entries",
    "stats"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "recorded_revision": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "recorded_at": {
      "type": "string"
    },
    "recorded_time_source": {
      "const": "git_committer_assertion"
    },
    "valid_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "target": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "exists": {
      "type": "boolean"
    },
    "ambiguous": {
      "type": "boolean"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "review_signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signal"
      }
    },
    "max_nodes": {
      "type": "integer",
      "minimum": 1
    },
    "truncated": {
      "type": "boolean"
    },
    "omitted_tree_entries": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "stats": {
      "type": "object",
      "required": [
        "view_nodes",
        "view_edges",
        "returned_nodes"
      ],
      "properties": {
        "view_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "view_edges": {
          "type": "integer",
          "minimum": 0
        },
        "returned_nodes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
