{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/outcome-record.schema.json",
  "title": "WhyKit canonical outcome payload",
  "description": "Fenced whykit-outcome JSON in a restricted draft Markdown record. Runtime additionally checks exact canonical ID/path/front matter, real dates, samples no later than creation and decimal precision <= 32 total ASCII digits / scale <= 12. Decimal strings are preserved, not calculated or verified. A target is a plan, not measurement evidence.",
  "type": "object",
  "required": ["format", "outcome_id", "decision_id", "metric", "baseline", "target", "observed", "implementation_refs"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "whykit.outcome/v1"},
    "outcome_id": {"type": "string", "maxLength": 18, "pattern": "^O-(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2,})(?![\\s\\S])"},
    "decision_id": {"type": "string", "pattern": "^D-[0-9]{3,}(?![\\s\\S])"},
    "metric": {
      "type": "object", "required": ["name", "unit", "definition"], "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "unit": {"type": "string", "minLength": 1, "maxLength": 128},
        "definition": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "baseline": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sample"}]},
    "observed": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sample"}]},
    "target": {"anyOf": [{"type": "null"}, {
      "type": "object", "required": ["value", "by"], "additionalProperties": false,
      "properties": {"value": {"$ref": "#/$defs/decimal"}, "by": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]}}
    }]},
    "implementation_refs": {"type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}}
  },
  "$defs": {
    "decimal": {"type": "string", "maxLength": 46, "pattern": "^-?(?:0|[1-9][0-9]{0,31})(?:\\.[0-9]{1,12})?(?![\\s\\S])"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"},
    "sample": {
      "type": "object", "required": ["value", "as_of", "claim"], "additionalProperties": false,
      "properties": {
        "value": {"$ref": "#/$defs/decimal"}, "as_of": {"$ref": "#/$defs/date"},
        "claim": {"anyOf": [{"type": "null"}, {
          "type": "object", "required": ["claim_id", "sha256"], "additionalProperties": false,
          "properties": {
            "claim_id": {"type": "string", "maxLength": 18, "pattern": "^C-(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2,})(?![\\s\\S])"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}
          }
        }]}
      }
    }
  }
}
