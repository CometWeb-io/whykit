{
  "name": "@whykit/explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "index": "node scripts/build-vault-index.mjs",
    "predev": "npm run index",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prebuild": "npm run index",
    "build": "tsc --noEmit && vite build",
    "check": "npm run index && npm run check:index && npm run typecheck && npm run lint && npm test && vite build",
    "check:index": "node scripts/check-index.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "e2e:build": "node scripts/build-e2e.mjs",
    "e2e": "npm run e2e:build && playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.510.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
