{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/rule-catalog.schema.json",
  "title": "WhyKit lint rule catalog",
  "description": "Output of `whykit rules --json`.",
  "type": "object",
  "required": [
    "contract_version",
    "count",
    "rules"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "default_level",
          "summary",
          "why",
          "fix"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
          },
          "default_level": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "summary": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
