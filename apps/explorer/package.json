{
  "name": "@whykit/explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "index": "node scripts/build-vault-index.mjs",
    "predev": "npm run index",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run index",
    "build": "tsc --noEmit && vite build",
    "check": "npm run index && npm run check:index && npm run typecheck && npm test && vite build",
    "check:index": "node scripts/check-index.mjs",
    "test": "node --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "lucide-react": "^0.510.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
