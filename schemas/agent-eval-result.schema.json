{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/agent-eval-result.schema.json",
  "title": "WhyKit offline agent evaluation result",
  "type": "object",
  "required": [
    "contract_version",
    "format",
    "cases_sha256",
    "responses_sha256",
    "count",
    "passed",
    "pass_rate",
    "false_answers",
    "false_abstentions",
    "citation_precision",
    "required_citation_recall",
    "unlicensed_citations",
    "forbidden_phrase_matches",
    "results"
  ],
  "properties": {
    "format": {
      "const": "whykit.agent-eval/v1"
    },
    "cases_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "responses_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "pass_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "false_answers": {
      "type": "integer",
      "minimum": 0
    },
    "false_abstentions": {
      "type": "integer",
      "minimum": 0
    },
    "citation_precision": {
      "type": [
        "number",
        "null"
      ],
      "maximum": 1,
      "minimum": 0
    },
    "required_citation_recall": {
      "type": [
        "number",
        "null"
      ],
      "maximum": 1,
      "minimum": 0
    },
    "unlicensed_citations": {
      "type": "integer",
      "minimum": 0
    },
    "forbidden_phrase_matches": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "pass",
          "violations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "maxLength": 80
          },
          "pass": {
            "type": "boolean"
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "contract_version": {
      "const": 1
    }
  },
  "additionalProperties": false
}
