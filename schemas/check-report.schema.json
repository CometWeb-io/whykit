{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/check-report.schema.json",
  "title": "WhyKit policy gate report",
  "type": "object",
  "required": ["contract_version", "profile", "passed", "checks", "lint"],
  "properties": {
    "contract_version": {"const": 1},
    "profile": {"type": "string", "minLength": 1},
    "profile_config": {"type": "object"},
    "config_source": {"type": "string"},
    "as_of": {"type": "string"},
    "passed": {"type": "boolean"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed", "detail"],
        "properties": {
          "name": {"type": "string"},
          "passed": {"type": "boolean"},
          "detail": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "lint": {
      "type": "object",
      "properties": {
        "overrides": {
          "type": "array",
          "description": "Present only when whykit.toml declares [rules.overrides] or the profile sets secrets = false; same entries as lint --json.",
          "items": {
            "type": "object",
            "required": ["rule", "level", "paths", "reason", "security", "matched"],
            "properties": {
              "rule": {"type": "string", "minLength": 1},
              "level": {"enum": ["error", "warning", "off"]},
              "paths": {"type": "array", "items": {"type": "string"}},
              "reason": {"type": ["string", "null"]},
              "security": {"type": "boolean"},
              "matched": {"type": "integer", "minimum": 0},
              "skipped_by": {"type": "string", "minLength": 1},
              "suppressed": {"type": "array", "items": {"type": "object"}}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
