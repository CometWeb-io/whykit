{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/workspace-status.schema.json",
  "title": "WhyKit local workspace status",
  "description": "Local operational metadata, never a public export or an authorization boundary.",
  "type": "object",
  "required": [
    "contract_version",
    "audience",
    "as_of",
    "vaults"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "audience": {
      "const": "local"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "vaults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "alias",
              "status"
            ],
            "properties": {
              "alias": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
              },
              "status": {
                "type": "object",
                "required": [
                  "documents",
                  "errors",
                  "warnings",
                  "review_due",
                  "review_overdue",
                  "due_days"
                ],
                "properties": {
                  "documents": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "errors": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "warnings": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "review_due": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "review_overdue": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "due_days": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "alias",
              "error"
            ],
            "properties": {
              "alias": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
              },
              "error": {
                "enum": [
                  "unsafe_path",
                  "vault_not_found",
                  "invalid_config",
                  "read_failed"
                ]
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
