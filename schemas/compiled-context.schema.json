{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/compiled-context.schema.json",
  "title": "WhyKit byte-bounded compiled context",
  "type": "object",
  "properties": {
    "format": {
      "const": "whykit.compiled-context/v1"
    },
    "contract_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "compiled",
        "refused"
      ]
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "query": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "ranking": {
          "enum": [
            "substring",
            "bm25",
            "hybrid"
          ]
        },
        "max_docs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 160,
          "maximum": 4194304
        },
        "agent": {
          "enum": [
            "generic",
            "cursor",
            "claude",
            "codex"
          ]
        },
        "allowed_sensitivities": {
          "type": "array",
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "targets",
        "query",
        "ranking",
        "max_docs",
        "max_bytes",
        "agent",
        "allowed_sensitivities"
      ],
      "additionalProperties": false
    },
    "preamble": {
      "type": "string"
    },
    "content_trust": {
      "const": "untrusted_data"
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "explicit",
              "query"
            ]
          },
          "kind": {
            "enum": [
              "document",
              "decision",
              "evidence"
            ]
          },
          "record": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "sensitivity": {
                "type": "string"
              },
              "source_of_truth": {
                "type": "boolean"
              },
              "decision_id": {
                "type": "string",
                "pattern": "^D-[0-9]{3,}$"
              },
              "claim_id": {
                "type": "string",
                "pattern": "^C-[0-9]{3,}$"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "content": {
            "type": "string"
          },
          "content_truncated": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "active",
                    "retired",
                    "missing"
                  ]
                },
                "record": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "date": {
                          "type": "string"
                        },
                        "accessed": {
                          "type": "string"
                        },
                        "location": {
                          "type": "string"
                        },
                        "claims": {
                          "type": "string"
                        },
                        "sensitivity": {
                          "type": "string"
                        },
                        "retired_on": {
                          "type": "string"
                        },
                        "why": {
                          "type": "string"
                        },
                        "replaced_by": {
                          "type": "string"
                        }
                      },
                      "required": [],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "state",
                "record"
              ],
              "additionalProperties": false
            }
          },
          "applicability": {
            "type": "object",
            "properties": {
              "as_of": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "applicable",
                  "needs_review",
                  "reference",
                  "unknown",
                  "not_decision"
                ]
              },
              "premise": {
                "type": "boolean"
              },
              "local_approval": {
                "enum": [
                  "matched",
                  "unverified",
                  "unavailable",
                  "not_applicable"
                ]
              },
              "declared_validity": {
                "type": "object",
                "properties": {
                  "state": {
                    "enum": [
                      "active",
                      "not_yet",
                      "expired",
                      "unknown",
                      "invalid"
                    ]
                  },
                  "valid_from": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "valid_until": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "state",
                  "valid_from",
                  "valid_until"
                ],
                "additionalProperties": false
              },
              "reasons": {
                "type": "array",
                "items": {
                  "enum": [
                    "not_decision",
                    "invalid_decision",
                    "ambiguous_decision",
                    "not_approved",
                    "superseded",
                    "approval_unavailable",
                    "approval_unverified",
                    "record_future",
                    "validity_unknown",
                    "validity_not_yet",
                    "validity_expired",
                    "validity_invalid",
                    "review_overdue",
                    "review_date_invalid",
                    "review_required",
                    "evidence_missing",
                    "evidence_retired",
                    "evidence_stale",
                    "evidence_date_invalid",
                    "evidence_future",
                    "evidence_unbounded",
                    "no_evidence",
                    "claim_unavailable",
                    "claim_unpinned",
                    "claim_snapshot_changed",
                    "claim_contradicted",
                    "claim_model_assessment",
                    "claim_source_changed",
                    "claim_source_unknown",
                    "claim_source_ambiguous",
                    "claim_source_future",
                    "claim_validity_unknown",
                    "claim_not_current",
                    "review_archived"
                  ]
                },
                "uniqueItems": true
              }
            },
            "required": [
              "as_of",
              "state",
              "premise",
              "local_approval",
              "declared_validity",
              "reasons"
            ],
            "additionalProperties": false,
            "if": {
              "properties": {
                "state": {
                  "const": "applicable"
                }
              }
            },
            "then": {
              "properties": {
                "premise": {
                  "const": true
                }
              }
            },
            "else": {
              "properties": {
                "premise": {
                  "const": false
                }
              }
            }
          },
          "history": {
            "type": "object",
            "properties": {
              "supersedes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "decision_id": {
                      "type": "string",
                      "pattern": "^D-[0-9]{3,}$"
                    },
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "decision_id",
                    "path"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 8
              },
              "superseded_by": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "decision_id": {
                      "type": "string",
                      "pattern": "^D-[0-9]{3,}$"
                    },
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "decision_id",
                    "path"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 8
              },
              "reviews": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "outcome": {
                      "enum": [
                        "approved",
                        "confirmed",
                        "update-required",
                        "supersede-required",
                        "archived"
                      ]
                    },
                    "row_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "occurrence": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "date",
                    "outcome",
                    "row_sha256",
                    "occurrence"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 8
              },
              "unavailable": {
                "type": "boolean"
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "supersedes",
              "superseded_by",
              "reviews",
              "unavailable",
              "truncated"
            ],
            "additionalProperties": false
          },
          "retrieval": {
            "type": "object",
            "properties": {
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "lexical_score": {
                "type": "number",
                "minimum": 0
              },
              "lexical_normalized": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "graph_support": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "explanation": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/explanation"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "score",
              "lexical_score",
              "lexical_normalized",
              "graph_support",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "target",
          "origin",
          "kind",
          "record",
          "content",
          "content_truncated",
          "evidence",
          "applicability",
          "history"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "document",
              "evidence",
              "review"
            ]
          },
          "target": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "kind",
          "target",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "level": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "code",
          "level",
          "line"
        ],
        "additionalProperties": false
      }
    },
    "omissions": {
      "type": "object",
      "properties": {
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string"
              },
              "origin": {
                "const": "explicit"
              },
              "reason": {
                "enum": [
                  "missing",
                  "ambiguous"
                ]
              }
            },
            "required": [
              "target",
              "origin",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "explicit_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "query_matches": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "unresolved",
        "explicit_targets",
        "query_matches"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 160,
          "maximum": 4194304
        },
        "used_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_bytes"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "snapshot_sha256",
        "policy_sha256",
        "report_sha256"
      ],
      "additionalProperties": false
    },
    "error": {
      "enum": [
        "budget_too_small",
        "scope_too_large"
      ]
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "truncation": {
          "$ref": "#/$defs/truncation"
        }
      },
      "required": [
        "limits",
        "truncation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "contract_version",
    "status",
    "budget"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "status": {
        "const": "compiled"
      }
    }
  },
  "then": {
    "required": [
      "format",
      "contract_version",
      "status",
      "as_of",
      "inputs",
      "preamble",
      "content_trust",
      "execution_authorized",
      "contexts",
      "citations",
      "warnings",
      "omissions",
      "budget",
      "manifest"
    ],
    "properties": {
      "error": false,
      "budget": {
        "required": [
          "used_bytes"
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "inputs": {
              "properties": {
                "ranking": {
                  "const": "hybrid"
                }
              }
            }
          }
        },
        "then": {
          "required": [
            "retrieval"
          ]
        },
        "else": {
          "properties": {
            "retrieval": false,
            "contexts": {
              "items": {
                "properties": {
                  "retrieval": false
                }
              }
            }
          }
        }
      }
    ]
  },
  "else": {
    "required": [
      "error"
    ],
    "properties": {
      "as_of": false,
      "inputs": false,
      "preamble": false,
      "content_trust": false,
      "execution_authorized": false,
      "contexts": false,
      "citations": false,
      "warnings": false,
      "omissions": false,
      "manifest": false,
      "retrieval": false
    }
  },
  "$defs": {
    "explanation": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "seed_normalized": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "edge_weight_product": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "evidence",
                  "wikilink",
                  "outcome_decision",
                  "measurement_claim"
                ]
              },
              "walk_direction": {
                "enum": [
                  "forward",
                  "reverse"
                ]
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "from",
              "to",
              "type",
              "walk_direction",
              "weight"
            ],
            "additionalProperties": false
          },
          "maxItems": 2
        }
      },
      "required": [
        "seed",
        "depth",
        "seed_normalized",
        "edge_weight_product",
        "decay",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "seed_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_edges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "construction_nodes": {
          "const": 25000
        },
        "visible_bytes": {
          "const": 67108864
        },
        "tokens": {
          "const": 2000000
        },
        "constructed_edges": {
          "const": 200000
        },
        "query_bytes": {
          "const": 4096
        }
      },
      "required": [
        "limit",
        "seed_limit",
        "max_depth",
        "max_nodes",
        "max_edges",
        "construction_nodes",
        "visible_bytes",
        "tokens",
        "constructed_edges",
        "query_bytes"
      ],
      "additionalProperties": false
    },
    "truncation": {
      "type": "object",
      "properties": {
        "seeds": {
          "type": "boolean"
        },
        "max_depth": {
          "type": "boolean"
        },
        "max_nodes": {
          "type": "boolean"
        },
        "max_edges": {
          "type": "boolean"
        },
        "results": {
          "type": "boolean"
        }
      },
      "required": [
        "seeds",
        "max_depth",
        "max_nodes",
        "max_edges",
        "results"
      ],
      "additionalProperties": false
    }
  }
}
