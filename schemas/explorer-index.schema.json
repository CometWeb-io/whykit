{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/explorer-index.schema.json",
  "title": "WhyKit Explorer index",
  "description": "Output of `whykit explorer-index`, consumed by apps/explorer. Keys other than `contract_version` use the Explorer's camelCase.",
  "type": "object",
  "required": [
    "contract_version",
    "generatedAt",
    "vaultName",
    "docs",
    "evidence",
    "decisions",
    "reviews",
    "lint"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E-\\d{3,}$"
            },
            "description": "Every evidence ID the note cites in front matter or body, sorted and unique. IDs inside inline code or fenced code blocks are examples, not citations, and are left out (the same rule as whykit graph, impact and trace)."
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lint": {
      "type": "object",
      "required": [
        "files",
        "errors",
        "warnings",
        "findings"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "description": "Freshness thresholds from the vault's whykit.toml (defaults when absent).",
      "properties": {
        "evidenceAccessAgeDays": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "decisionReviewDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "statusDueDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
