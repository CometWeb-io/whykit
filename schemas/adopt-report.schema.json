{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/adopt-report.schema.json",
  "title": "WhyKit adoption inventory",
  "description": "Output of `whykit adopt --json`.",
  "type": "object",
  "required": [
    "contract_version",
    "profile",
    "source",
    "vault",
    "write",
    "score",
    "candidates"
  ],
  "properties": {
    "preservation": {
      "type": "object",
      "required": ["target", "passed", "files", "scope"],
      "properties": {
        "target": {"type": "string"},
        "passed": {"type": "boolean"},
        "scope": {"type": "string"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "source_sha256", "target_sha256", "unchanged", "missing_wikilinks", "missing_ids", "review_history", "issues"],
            "properties": {
              "path": {"type": "string"},
              "source_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
              "target_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
              "unchanged": {"type": "boolean"},
              "missing_wikilinks": {"type": "array", "items": {"type": "string"}},
              "missing_ids": {"type": "array", "items": {"type": "string", "pattern": "^(?:D|E)-[0-9]{3,}$"}},
              "review_history": {"enum": ["not_checked", "not_present", "unchanged", "unrecognized", "changed", "preserved"]},
              "issues": {
                "type": "array",
                "items": {"enum": ["unreadable_source", "source_changed", "unsafe_target", "missing_file", "wikilinks_lost", "ids_lost", "decision_id_changed", "source_ids_lost", "history_unrecognized", "history_changed", "unreadable_file"]}
              }
            }
          }
        }
      }
    },
    "contract_version": {
      "const": 1
    },
    "profile": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "vault": {
      "type": "string"
    },
    "write": {
      "type": "boolean"
    },
    "score": {
      "type": "object",
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "readiness_pct": {
          "type": "number"
        },
        "id_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Decision IDs claimed more than once, within the import or by the vault already."
        }
      },
      "additionalProperties": true
    },
    "scope_note": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "assessment",
          "destination"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "assessment": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "has_front_matter": {
            "type": "boolean"
          },
          "whykit_ready": {
            "type": "boolean"
          },
          "looks_like_decision": {
            "type": "boolean"
          },
          "duplicate_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "words": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "ingestion_record": {
      "type": [
        "string",
        "null"
      ]
    },
    "migration": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
