{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/workspace-report.schema.json",
  "title": "WhyKit workspace status",
  "description": "Local per-vault status and isolated failures; status objects follow status-report.schema.json.",
  "type": "object",
  "required": ["contract_version", "as_of", "exit_code", "vaults"],
  "properties": {
    "contract_version": {"const": 1},
    "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "exit_code": {"enum": [0, 1, 2, 70]},
    "vaults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["root", "exit_code"],
        "properties": {
          "root": {"type": "string"},
          "exit_code": {"enum": [0, 1, 2, 70]},
          "due_days": {"type": "integer", "minimum": 0},
          "status": {
            "$ref": "https://cometweb.io/schemas/whykit/status-report.schema.json"
          },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {"enum": ["vault_not_found", "invalid_target", "invalid_config", "io_error", "internal_error"]},
              "message": {"type": "string"},
              "hint": {"type": ["string", "null"]}
            }
          }
        },
        "anyOf": [
          {"required": ["status", "due_days"], "properties": {"error": false, "exit_code": {"enum": [0, 1]}}},
          {"required": ["error"], "properties": {"status": false, "due_days": false, "exit_code": {"enum": [2, 70]}}}
        ]
      }
    }
  }
}
