{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/rule-catalog.schema.json",
  "title": "WhyKit lint rule catalog",
  "description": "Output of `whykit rules --json`.",
  "type": "object",
  "required": [
    "contract_version",
    "count",
    "rules"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "default_level",
          "summary",
          "why",
          "fix"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
          },
          "default_level": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "summary": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "security": {
            "type": "boolean",
            "description": "Lowering or disabling this rule in whykit.toml requires a reason."
          },
          "custom": {
            "type": "boolean",
            "description": "Defined by the vault's whykit.toml ([[rules.custom]])."
          },
          "applies_to": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "checks": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "level",
          "paths",
          "reason",
          "security"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "level": {
            "enum": [
              "error",
              "warning",
              "off"
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "security": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
