{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/explorer-index-v2.schema.json",
  "title": "WhyKit Explorer index (claims opt-in v2)",
  "description": "Output of `whykit explorer-index`, consumed by apps/explorer. Keys other than `contract_version` use the Explorer's camelCase.",
  "type": "object",
  "required": [
    "contract_version",
    "generatedAt",
    "vaultName",
    "docs",
    "evidence",
    "decisions",
    "reviews",
    "lint"
  ],
  "properties": {
    "contract_version": {
      "const": 2
    },
    "generatedAt": {
      "type": "string"
    },
    "vaultName": {
      "type": "string"
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E-\\d{3,}$"
            },
            "description": "Every evidence ID the note cites in front matter or body, sorted and unique. IDs inside inline code or fenced code blocks are examples, not citations, and are left out (the same rule as whykit graph, impact and trace)."
          },
          "claimId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^C-[0-9]{3,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^C-[0-9]{3,}$"
            },
            "uniqueItems": true
          },
          "statement": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "validFrom": {
            "type": "string"
          },
          "validTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastVerified": {
            "type": [
              "string",
              "null"
            ]
          },
          "verificationStatus": {
            "enum": [
              "supported",
              "disputed",
              "unsupported",
              "unknown"
            ]
          },
          "verificationReasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claimRelations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "evidence_id",
                "source_snapshot_hash",
                "fragment",
                "relation",
                "snapshot",
                "observed_at",
                "rationale",
                "fragment_text",
                "usable",
                "reasons"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "pattern": "^E-[0-9]{3,}$"
                },
                "source_snapshot_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "fragment": {
                  "type": "string",
                  "pattern": "^lines:[1-9][0-9]*-[1-9][0-9]*$"
                },
                "relation": {
                  "enum": [
                    "supports",
                    "contradicts"
                  ]
                },
                "snapshot": {
                  "type": "string",
                  "pattern": "^00-context/claim-snapshots/[0-9a-f]{64}\\.txt$"
                },
                "observed_at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "fragment_text": {
                  "type": "string"
                },
                "usable": {
                  "type": "boolean"
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "fragment_truncated": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "historyReconstructed": {
            "const": false
          },
          "assessmentAsOf": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "requiresReview": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "sensitivity": {
            "type": "string",
            "description": "Optional explicit row label in evidence-list; effective register/replacement classification in Explorer. Unknown classification is withheld in filtered exports."
          }
        },
        "additionalProperties": true
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lint": {
      "type": "object",
      "required": [
        "files",
        "errors",
        "warnings",
        "findings"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "contract_version": {
          "const": 2
        }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "description": "Freshness thresholds from the vault's whykit.toml (defaults when absent).",
      "properties": {
        "evidenceAccessAgeDays": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "decisionReviewDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "statusDueDays": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "exportMode": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "description": "Public excludes non-public notes and dependent references; private is an explicit local opt-in."
    }
  },
  "additionalProperties": true
}
