{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cometweb.io/schemas/whykit/scope-check.schema.json",
  "title": "WhyKit scope check",
  "description": "Output of `whykit scope check --json`: live decisions' applies_to patterns and watch_terms checked against the repository's tracked files.",
  "type": "object",
  "required": [
    "contract_version",
    "root",
    "repo",
    "tracked_files",
    "scanned_for_terms",
    "decisions",
    "summary",
    "problems"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "tracked_files": {
      "type": "integer",
      "minimum": 0
    },
    "scanned_for_terms": {
      "type": "integer",
      "minimum": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision_id",
          "title",
          "path",
          "patterns",
          "terms",
          "findings"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "pattern": "^D-[0-9]{3,}$"
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pattern",
                "files"
              ],
              "properties": {
                "pattern": {
                  "type": "string"
                },
                "files": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": true
            }
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "value",
                "detail"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "dead_pattern",
                    "broad_pattern",
                    "unseen_term",
                    "invalid",
                    "unscoped"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "dead_pattern",
        "broad_pattern",
        "unseen_term",
        "invalid",
        "unscoped"
      ],
      "properties": {
        "dead_pattern": {
          "type": "integer",
          "minimum": 0
        },
        "broad_pattern": {
          "type": "integer",
          "minimum": 0
        },
        "unseen_term": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "unscoped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "problems": {
      "type": "integer",
      "minimum": 0,
      "description": "Dead and invalid patterns: what --strict fails on."
    }
  },
  "additionalProperties": true
}
